# Documentation-only allowlist. Never mirror the implementation repository here.
*
!/.gitignore
!/LICENSE
!/*.md
!/llms.txt
!/docs/
!/docs/*.md
!/releases/
!/releases/*.md
!/releases/*/
!/releases/*/*.md
!/packages/
!/packages/*/
!/packages/*/*.md
!/packages/*/package.json
!/.release/
!/.release/current.json
!/.release/*/
!/.release/*/*.json
!/.release/*/*.md
!/.release/*/*.tgz
!/scripts/
!/scripts/*.mjs
!/types/
!/types/*.md
!/types/*.json
!/types/*/
!/types/*/*.json
!/skills/
!/skills/ludicord/
!/skills/ludicord/SKILL.md
!/skills/ludicord/manifest.yaml
!/skills/ludicord/knowledge-map.md
!/skills/ludicord/agents/
!/skills/ludicord/agents/openai.yaml
!/skills/ludicord/references/
!/skills/ludicord/references/*.md
!/skills/ludicord/references/**/
!/skills/ludicord/references/**/*.md
!/.github/
!/.github/copilot-instructions.md
!/.github/assets/
!/.github/assets/ludicord-banner.png
!/.github/assets/ludicord-logo.png
!/.github/assets/ludicord-social-preview.png
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.md
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/dependabot.yml
!/.github/pull_request_template.md
!/examples/
!/examples/**
!/.agents/*
!/.agents/
!/.agents/skills/
!/.agents/skills/ludicord/
!/.agents/skills/ludicord/SKILL.md
!/.agents/rules/
!/.agents/rules/*.md
!/.cursor/
!/.cursor/rules/
!/.cursor/rules/*.mdc
# Sensitive and generated content remains excluded everywhere.
.env
.env.*
!examples/**/.env.example
*.map
*.log
node_modules/
dist/
src/
.ludicord/
