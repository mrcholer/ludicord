# Documentation-only allowlist. Never mirror the implementation repository here.
*
!/.gitignore
!/*.md
!/llms.txt
!/docs/
!/docs/*.md
!/releases/
!/releases/*.md
!/packages/
!/packages/*/
!/packages/*/*.md
!/packages/*/package.json
!/.release/
!/.release/current.json
!/.release/*/
!/.release/*/*.json
!/.release/*/*.md
!/.release/*/*.tgz
!/scripts/
!/scripts/*.mjs
!/skills/
!/skills/ludicord/
!/skills/ludicord/SKILL.md
!/skills/ludicord/agents/
!/skills/ludicord/agents/openai.yaml
!/skills/ludicord/references/
!/skills/ludicord/references/*.md
!/.github/
!/.github/assets/
!/.github/assets/ludicord-banner.png
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.md
!/.github/ISSUE_TEMPLATE/config.yml
# Sensitive and generated content remains excluded everywhere.
.env
.env.*
*.map
*.log
node_modules/
dist/
src/
.ludicord/
